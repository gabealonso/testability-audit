{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/typecheck-ts.sh",
            "statusMessage": "Type-checking..."
          }
        ]
      }
    ]
  }
}
